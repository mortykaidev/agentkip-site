# AgentKip.ai environment — copy to .env.local for development.
# Every variable is optional in dev: with nothing set, the site runs with a
# JSON file store (.data/site.json), no sign-in, and /admin open in dev only.

# --- Database (Neon Postgres via Vercel marketplace) -------------------------
# When set, the site uses Neon via drizzle-orm; when unset, the JSON file store.
# Push the schema with: npm run db:push  (drizzle-kit needs DATABASE_URL in the
# shell or a .env file; e.g. `DATABASE_URL=… npm run db:push`).
DATABASE_URL=

# --- Auth (Clerk) -------------------------------------------------------------
# Both keys must be set to enable sign-in, /account, and Clerk-gated /admin.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Clerk user ids allowed into /admin (Brandon's user id).
# Find yours in the Clerk dashboard under Users → your user → User ID.
ADMIN_USER_IDS=

# --- Uploads (Vercel Blob) ----------------------------------------------------
# Enables gallery image uploads from /admin. Without it, paste image URLs.
BLOB_READ_WRITE_TOKEN=

# --- Site ----------------------------------------------------------------------
# Canonical origin used for metadata/OG URLs.
NEXT_PUBLIC_SITE_URL=https://agentkip.ai

# --- W1 billing and recoverable bootstrap claims --------------------------------
# Server-only Stripe test-mode credentials and server-side identifiers. Do not put
# values in source, documentation, browser variables, or PR evidence.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TESTER_PRICE_ID=
STRIPE_TESTER_PRODUCT_ID=
# Server-only canonical base64url values with at least 32 bytes of entropy. The
# redemption bearer, claim HMAC pepper, and rate-limit HMAC pepper are distinct.
INTERNAL_BOOTSTRAP_CLAIM_REDEEM_TOKEN=
BOOTSTRAP_CLAIM_PEPPER_V1=
BOOTSTRAP_RATE_LIMIT_PEPPER_V1=
